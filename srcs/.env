# --- Login / domain ---
LOGIN=noaziki
DOMAIN_NAME=noaziki.42.fr
# Host path where the two mandatory named volumes physically store data
DATA_PATH=/home/noaziki/data

# --- MariaDB ---
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
# root password and wp_user password come from Docker secrets

# --- WordPress ---
WP_TITLE=Nouhaila Aziki
WP_URL=https://noaziki.42.fr

# Administrator account (username intentionally does NOT contain
# admin/Admin/administrator/Administrator, per subject requirement)
WP_ADMIN_USER=noaziki_boss
WP_ADMIN_EMAIL=noaziki@student.42.fr

# Second, non-administrator WordPress user
WP_USER=noaziki_editor
WP_USER_EMAIL=editor@noaziki.42.fr

# --- Redis (bonus) ---
REDIS_PORT=6379

# --- FTP (bonus) ---
FTP_USER=noaziki_ftp
# ftp password comes from Docker secret

# --- Adminer (bonus) ---
ADMINER_PORT=8080

# --- Portfolio (bonus) ---
PORTFOLIO_PORT=8081
